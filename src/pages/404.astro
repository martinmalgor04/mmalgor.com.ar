---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { profile, whatsappHref } from '../data/profile';
---

<Base
  chrome="minimal"
  title={`No está — ${profile.name}`}
  description={`Esa página no existe. El sitio oficial de ${profile.name} es mmalgor.com.ar.`}
  noindex
  markdownPath={null}
>
  <article class="page">
    <div class="container">
      <div class="page__inner">
        <p class="page__kicker">404</p>
        <h1 class="page__title">Eso no está.</h1>
        <div class="page__body">
          <p>Volvé al sitio de {profile.name}.</p>
        </div>
        <div class="page__links">
          <a class="cta cta--primary" href="/" data-umami-event="click-home-404">
            Ir al inicio
            <Icon name="lucide:chevron-right" size={18} aria-hidden="true" />
          </a>
          <a class="cta cta--secondary" href={whatsappHref} target="_blank" rel="noopener" data-umami-event="click-whatsapp-404">
            <Icon name="tabler:brand-whatsapp" size={18} aria-hidden="true" />
            Escribime por WhatsApp
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </div>
      </div>
    </div>
  </article>
</Base>
