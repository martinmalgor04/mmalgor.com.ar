---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import ContactCtas from '../../components/ContactCtas.astro';
import { noteBySlug } from '../../data/notes';
import { profile } from '../../data/profile';
import { jsonLdArticle } from '../../lib/seo';

export function getStaticPaths() {
  return Object.keys(noteBySlug).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const note = noteBySlug[slug ?? ''];
if (!note) throw new Error(`Nota no encontrada: ${slug}`);
---

<Base
  chrome="minimal"
  title={`${note.title} — ${profile.name}`}
  description={note.description}
  ogType="article"
  jsonLd={jsonLdArticle(note)}
  published={note.date}
  modified={note.date}
>
  <article class="page">
    <div class="container">
      <div class="page__inner">
        <a class="page__back" href="/" data-umami-event="click-back-nota">
          <Icon name="lucide:arrow-left" size={16} aria-hidden="true" />
          Inicio
        </a>
        <p class="page__kicker">
          Nota · <time datetime={note.date}>{note.dateLabel}</time>
        </p>
        <h1 class="page__title">{note.title}</h1>
        <p class="page__byline">
          <a href="/">{profile.name}</a>
        </p>
        <div class="page__body">
          {note.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <ContactCtas waEvent="click-whatsapp-nota" liEvent="click-linkedin-nota" nowLink />
      </div>
    </div>
  </article>
</Base>
