---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { now } from '../data/now';
---

<Base
  title={`Ahora — ${profile.name}`}
  description={now.excerpt}
>
  <article class="page">
    <div class="container page__inner">
      <a class="page__back" href="/" data-umami-event="click-now-home">
        <Icon name="lucide:arrow-left" size={16} />
        Sitio
      </a>
      <p class="page__kicker">
        Ahora · <time datetime={now.updated}>{now.updatedLabel}</time>
      </p>
      <h1 class="page__title">Qué estoy haciendo ahora</h1>
      <div class="page__body">
        {now.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <p class="page__foot">
        <a class="cta cta--link" href="/notas/profesionalizar-sys">Estoy profesionalizando SyS</a>
      </p>
    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: 88px;
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .page__inner {
    max-width: 720px;
  }
  .page__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 40px;
    color: var(--muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .page__back:hover { color: var(--text); }
  .page__kicker {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-electric);
    margin-bottom: 12px;
  }
  .page__title {
    font-weight: 700;
    font-size: clamp(36px, 6vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 32px;
  }
  .page__body {
    display: grid;
    gap: 20px;
  }
  .page__body p {
    font-size: clamp(18px, 2.2vw, 21px);
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--muted);
    max-width: 46ch;
  }
  .page__foot { margin-top: 40px; }
</style>
