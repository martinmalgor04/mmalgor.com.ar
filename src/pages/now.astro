---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import ContactCtas from '../components/ContactCtas.astro';
import { profile } from '../data/profile';
import { now } from '../data/now';
---

<Base
  chrome="minimal"
  title={`Ahora — ${profile.name}`}
  description={now.excerpt}
  published={now.updated}
  modified={now.updated}
>
  <article class="page">
    <div class="container">
      <div class="page__inner">
        <a class="page__back" href="/" data-umami-event="click-back-now">
          <Icon name="lucide:arrow-left" size={16} aria-hidden="true" />
          Inicio
        </a>
        <p class="page__kicker">
          Ahora · <time datetime={now.updated}>{now.updatedLabel}</time>
        </p>
        <h1 class="page__title">Qué estoy haciendo ahora</h1>
        <div class="page__body">
          {now.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="page__foot">
          <a class="cta cta--link" href="/notas/profesionalizar-sys" data-umami-event="click-nota-now">
            Nota: Estoy profesionalizando SyS
            <Icon name="lucide:chevron-right" size={18} aria-hidden="true" />
          </a>
        </p>
        <ContactCtas waEvent="click-whatsapp-now" liEvent="click-linkedin-now" />
      </div>
    </div>
  </article>
</Base>
