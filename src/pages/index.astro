---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import LinkTile from '../components/LinkTile.astro';
import Stats from '../components/Stats.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import { profile, whatsappHref } from '../data/profile';
import { links } from '../data/links';
import { queHago, quienSoy, manifiesto, sys, contacto } from '../data/sections';

/**
 * Foto del avatar: cuando llegue, guardarla como src/assets/martin-malgor.jpg
 * (cuadrada, mínimo 512px). Este glob la detecta solo; sin archivo, monograma.
 */
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/martin-malgor.{jpg,jpeg,png,webp}', { eager: true });
const foto = Object.values(fotos)[0]?.default;
---

<Base>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="hero" id="inicio">
    <div class="container hero__inner">
      <div class="hero__avatar" data-rise>
        <Avatar initials={profile.initials} alt={`${profile.name}, ${profile.role}`} src={foto} />
      </div>

      <p class="hero__kicker" data-rise>{profile.bio}</p>
      <h1 class="hero__name" data-rise>{profile.name}</h1>
      <p class="hero__tagline" data-rise>{profile.tagline}</p>

      <div class="hero__tiles" data-rise>
        {links.map((l) => <LinkTile {...l} />)}
      </div>

      <div class="hero__foot" data-rise>
        <a class="cta cta--link" href="/martin-malgor.vcf" download data-umami-event="download-vcard">
          Guardar contacto
          <Icon name="lucide:chevron-right" size={18} />
        </a>
        <div class="hero__stats">
          <Stats items={profile.stats} />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ QUÉ HAGO ═══════════════════ -->
  <Section id="que-hago" tone="gray" kicker={queHago.eyebrow} title={queHago.title}>
    <div class="grid grid--2">
      {queHago.items.map((c) => <Card title={c.title} icon={c.icon}>{c.text}</Card>)}
    </div>
  </Section>

  <!-- ═══════════════════ QUIÉN SOY ═══════════════════ -->
  <Section id="quien-soy" tone="white" kicker={quienSoy.eyebrow} title={quienSoy.title}>
    <div class="facetas">
      {
        quienSoy.items.map((f) => (
          <article class="faceta" data-reveal>
            <span class="faceta__num" aria-hidden="true">{f.num}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ═══════════════════ CÓMO PIENSO ═══════════════════ -->
  <Section id="como-pienso" tone="navy" class="manifiesto">
    <h2 class="sr-only">Cómo pienso</h2>
    <p class="manifiesto__texto" data-reveal>
      {manifiesto.lines[0]}<br />
      {manifiesto.lines[1]} <span class="highlight">{manifiesto.highlight}</span><br />
      {manifiesto.lines[2]}
    </p>
    <div class="principios">
      {
        manifiesto.principios.map((p) => (
          <article class="principio" data-reveal>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ═══════════════════ SyS ═══════════════════ -->
  <Section id="sys" tone="gray">
    <div class="sys" data-reveal>
      <div class="sys__logo">
        <img src="/logo-sys-horizontal-color.png" width="600" height="69" loading="lazy" alt="Servicios & Sistemas" />
      </div>
      <div class="sys__body">
        <p class="sys__kicker">{sys.eyebrow}</p>
        <p class="sys__copy">{sys.text}</p>
        <a class="cta cta--link" href={profile.sys.url} target="_blank" rel="noopener" data-umami-event="click-sys-section">
          {sys.cta}
          <Icon name="lucide:chevron-right" size={18} />
        </a>
      </div>
    </div>
  </Section>

  <!-- ═══════════════════ CONTACTO ═══════════════════ -->
  <Section id="contacto" tone="white" title={contacto.title} center>
    <div class="contacto">
      <p class="contacto__sub" data-reveal>{contacto.text}</p>
      <div class="contacto__cta" data-reveal>
        <a class="cta cta--primary" href={whatsappHref} target="_blank" rel="noopener" data-umami-event="click-whatsapp-footer">
          Escribime por WhatsApp
        </a>
        <a class="cta cta--secondary" href={profile.linkedin} target="_blank" rel="me noopener" data-umami-event="click-linkedin-footer">
          Escribime por LinkedIn
        </a>
      </div>
      <ul class="contacto__links" role="list" data-reveal>
        <li>
          <span class="contacto__label">Email</span>
          <a href={`mailto:${profile.email}`} data-umami-event="click-email-footer">{profile.email}</a>
        </li>
        <li>
          <span class="contacto__label">WhatsApp</span>
          <a href={whatsappHref} target="_blank" rel="noopener">{profile.whatsapp.display}</a>
        </li>
        <li>
          <span class="contacto__label">Teléfono</span>
          <a href={`tel:${profile.whatsapp.tel}`}>{profile.whatsapp.display}</a>
        </li>
      </ul>
    </div>
  </Section>
</Base>

<style>
  /* ------------------------------ hero ------------------------------ */

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 88px;
    padding-bottom: 80px;
    background: var(--color-black);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: min(900px, 130vw);
    height: 720px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 55% 60% at 50% 20%, rgba(33, 150, 243, 0.14) 0%, transparent 65%),
      radial-gradient(ellipse 40% 45% at 65% 10%, rgba(162, 198, 212, 0.1) 0%, transparent 70%);
    pointer-events: none;
    animation: aurora 22s var(--ease) infinite;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Stagger de entrada sin atributos style (la CSP los bloquea). */
  .hero__inner > :nth-child(2) { --i: 1; }
  .hero__inner > :nth-child(3) { --i: 2; }
  .hero__inner > :nth-child(4) { --i: 3; }
  .hero__inner > :nth-child(5) { --i: 4; }
  .hero__inner > :nth-child(6) { --i: 5; }

  @keyframes aurora {
    0%, 100% { transform: translateX(-50%) translateY(0) scale(1); opacity: 1; }
    50% { transform: translateX(-46%) translateY(16px) scale(1.05); opacity: 0.85; }
  }

  .hero__avatar { margin-bottom: 28px; }

  .hero__kicker {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .hero__name {
    font-weight: 700;
    font-size: clamp(48px, 9vw, 84px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    text-shadow: 0 4px 60px rgba(0, 0, 0, 0.5);
  }
  .hero__tagline {
    margin-top: 18px;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--muted);
    max-width: 22ch;
  }

  .hero__tiles {
    width: 100%;
    max-width: 720px;
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .hero__foot {
    width: 100%;
    max-width: 720px;
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .hero__stats {
    width: 100%;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }

  /* ------------------------------ grillas ------------------------------ */

  .grid { display: grid; gap: 18px; }
  .grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  /* quién soy */
  .facetas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
  }
  .faceta {
    border-top: 1px solid var(--hairline);
    padding-top: 26px;
  }
  .faceta__num {
    display: block;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-electric);
    font-variant-numeric: tabular-nums;
    margin-bottom: 18px;
  }
  .faceta h3 {
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 10px;
  }
  .faceta p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* manifiesto */
  .manifiesto__texto {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
    font-weight: 600;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-white);
  }
  .manifiesto__texto .highlight { color: var(--color-sky); }
  .principios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px);
    margin-top: clamp(56px, 8vw, 88px);
  }
  .principio {
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .principio h3 {
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 8px;
  }
  .principio p {
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.68);
  }

  /* SyS: mención compacta, no protagonista */
  .sys {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }
  .sys__logo img { width: min(280px, 100%); height: auto; }
  .sys__body { display: grid; gap: 12px; justify-items: start; }
  .sys__kicker {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .sys__copy {
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
    max-width: 52ch;
  }

  /* contacto */
  .contacto {
    max-width: 640px;
    margin-inline: auto;
    display: grid;
    justify-items: center;
    gap: 32px;
    text-align: center;
  }
  .contacto__sub {
    font-size: clamp(18px, 2.2vw, 21px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--muted);
  }
  .contacto__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .contacto__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 48px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
    width: 100%;
    margin: 0;
    padding-left: 0;
    list-style: none;
  }
  .contacto__links li { display: flex; flex-direction: column; gap: 4px; }
  .contacto__label { font-size: 13px; color: var(--muted); }
  .contacto__links a {
    font-weight: 500;
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }
  .contacto__links a:hover { color: var(--color-electric); }

  /* ------------------------------ responsive ------------------------------ */

  @media (max-width: 900px) {
    .facetas, .principios { grid-template-columns: 1fr; gap: 28px; }
    .sys { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 72px; padding-bottom: 64px; }
    .hero__tiles { grid-template-columns: 1fr; gap: 12px; margin-top: 40px; }
    .grid--2 { grid-template-columns: 1fr; }
    .contacto__cta { flex-direction: column; width: 100%; }
    .contacto__cta :global(.cta) { width: 100%; }
  }
</style>
