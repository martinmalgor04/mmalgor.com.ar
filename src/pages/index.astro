---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import Stats from '../components/Stats.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import ContactCtas from '../components/ContactCtas.astro';
import { profile, whatsappHref } from '../data/profile';
import { queHago, sobreMi, manifiesto, sys, contacto, meetupsSection, novedades, words } from '../data/sections';
import MeetupList from '../components/MeetupList.astro';
import { feed } from '../data/feed';
---

<Base>
  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="hero" id="inicio">
    <div class="hero__spot" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__avatar" data-rise>
        <Avatar initials={profile.initials} alt={`${profile.name}, ${profile.role}`} src={profile.photo} />
      </div>

      <h1 class="hero__name" data-rise>{profile.name}</h1>
      <p class="hero__tagline" data-rise>{profile.tagline}</p>
      <p class="hero__identity" data-rise>
        {profile.identity.parts.map((part) => <span>{part}</span>)}
      </p>

      <div class="hero__actions" data-rise>
        <a class="cta cta--primary" href={whatsappHref} target="_blank" rel="noopener" data-umami-event="click-whatsapp-home">
          <Icon name="tabler:brand-whatsapp" size={18} aria-hidden="true" />
          Escribime por WhatsApp
          <span class="sr-only">(se abre en otra pestaña)</span>
        </a>
        <a class="cta cta--secondary" href="#que-hago" data-umami-event="click-quehago-home">
          Qué hago
        </a>
      </div>

      <div class="hero__foot" data-rise>
        <div class="hero__stats">
          <Stats items={profile.stats} kicker={profile.statsKicker} />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ QUÉ HAGO ═══════════════════ -->
  <Section id="que-hago" tone="white" title={queHago.title}>
    <div class="grid grid--2">
      {queHago.items.map((c) => (
        <Card title={c.title} icon={c.icon} href={c.href} event={c.event}>{c.text}</Card>
      ))}
    </div>
  </Section>

  <!-- ═══════════════════ SOBRE MÍ ═══════════════════ -->
  <Section id="sobre-mi" tone="gray" title={sobreMi.title} center>
    <div class="sobre">
      <div class="sobre__intro" data-reveal>
        <p class="sobre__lead">{sobreMi.lead}</p>
      </div>
      <div class="facetas">
        {
          sobreMi.items.map((f) => (
            <article class="faceta" data-reveal>
              {
                f.mark && (
                  <div class="faceta__marca">
                    <img
                      class:list={['faceta__mark', `faceta__mark--${f.mark.kind}`]}
                      src={f.mark.src}
                      width={f.mark.width}
                      height={f.mark.height}
                      alt=""
                    />
                  </div>
                )
              }
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- ═══════════════════ CÓMO PIENSO ═══════════════════ -->
  <Section id="como-pienso" tone="think" class="manifiesto">
    <h2 class="sr-only">Cómo pienso</h2>
    <p class="manifiesto__texto">
      {words(manifiesto.lines[0]).map((w) => <span class="word">{w}</span>)}
      <br />
      {words(manifiesto.lines[1]).map((w) => <span class="word">{w}</span>)}
      <span class="highlight">
        {words(manifiesto.highlight).map((w) => <span class="word">{w}</span>)}
      </span>
      <br />
      {words(manifiesto.lines[2]).map((w) => <span class="word">{w}</span>)}
    </p>
    <div class="principios">
      {
        manifiesto.principios.map((p) => (
          <article class="principio" data-pin-reveal>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ═══════════════════ SyS ═══════════════════ -->
  <Section id="sys" tone="gray" title={sys.title} compact>
    <div class="sys" data-reveal>
      <div class="sys__logo">
        <img src={profile.sys.logo} width="720" height="87" alt="" />
      </div>
      <div class="sys__body">
        <p class="sys__kicker">{sys.eyebrow}</p>
        <p class="sys__copy">{sys.text}</p>
        <p class="sys__addr">{sys.addressLine}</p>
        <a class="cta cta--link" href={profile.sys.url} target="_blank" rel="noopener" data-umami-event="click-sys-section">
          {sys.cta}
          <Icon name="lucide:chevron-right" size={18} aria-hidden="true" />
          <span class="sr-only">(se abre en otra pestaña)</span>
        </a>
      </div>
    </div>
  </Section>

  <!-- ═══════════════════ MEETUPS ═══════════════════ -->
  <Section id="meetups" tone="white" kicker={meetupsSection.eyebrow} title={meetupsSection.title}>
    <p class="meetups__lead" data-reveal>{meetupsSection.lead}</p>
    <MeetupList />
  </Section>

  <!-- ═══════════════════ NOVEDADES ═══════════════════ -->
  <Section id="ahora" tone="gray" kicker={novedades.eyebrow} title={novedades.title} compact>
    <div class="novedades">
      {
        feed.map((item) => (
          <article class="entrada">
            <p class="entrada__kicker">
              {item.kind} · <time datetime={item.date}>{item.dateLabel}</time>
            </p>
            <h3 class="entrada__title">{item.title}</h3>
            <p class="entrada__text">{item.excerpt}</p>
            <a class="cta cta--link" href={item.href} data-umami-event={item.event}>
              {item.cta}
              <Icon name="lucide:chevron-right" size={18} aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- ═══════════════════ CONTACTO ═══════════════════ -->
  <Section id="contacto" tone="white" title={contacto.title} center>
    <div class="contacto">
      <p class="contacto__sub" data-reveal>{contacto.text}</p>
      <div class="contacto__ctas" data-reveal>
        <ContactCtas waEvent="click-whatsapp-contacto" liEvent="click-linkedin-contacto" vcard center schedule />
      </div>
      <p class="contacto__recruiter" data-reveal>{contacto.recruiter}</p>
      <ul class="contacto__links" role="list" data-reveal>
        <li>
          <span class="contacto__label">Email</span>
          <a href={`mailto:${profile.email}`} data-umami-event="click-email-contacto">{profile.email}</a>
          <button class="contacto__copy" type="button" data-copy={profile.email} aria-label={`Copiar ${profile.email}`}>
            Copiar
            <span class="tile__copied" role="status"></span>
          </button>
        </li>
        <li>
          <span class="contacto__label">WhatsApp</span>
          <a href={whatsappHref} target="_blank" rel="noopener" data-umami-event="click-whatsapp-contacto-num">
            {profile.whatsapp.display}
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </li>
        <li>
          <span class="contacto__label">X</span>
          <a href={profile.x} target="_blank" rel="me noopener" data-umami-event="click-x-contacto">
            @{profile.xHandle}
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </li>
        <li>
          <span class="contacto__label">Instagram</span>
          <a href={profile.instagram} target="_blank" rel="me noopener" data-umami-event="click-instagram-contacto">
            @{profile.instagramHandle}
            <span class="sr-only">(se abre en otra pestaña)</span>
          </a>
        </li>
      </ul>
    </div>
  </Section>

</Base>

<style>
  /* ------------------------------ hero ------------------------------ */

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 88px;
    padding-bottom: 80px;
    background: var(--color-black);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -6%;
    width: min(900px, 130vw);
    height: 720px;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 55% 60% at 50% 20%, rgba(33, 150, 243, 0.14) 0%, transparent 65%),
      radial-gradient(ellipse 40% 45% at 65% 10%, rgba(162, 198, 212, 0.1) 0%, transparent 70%);
    pointer-events: none;
    animation: aurora 22s var(--ease) infinite;
  }
  .hero__spot {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: min(640px, 90vw);
    height: min(640px, 90vw);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(33, 150, 243, 0.28) 0%, rgba(162, 198, 212, 0.08) 38%, transparent 68%);
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.045;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='0.55'/></svg>");
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Stagger de entrada. style-src-attr 'unsafe-inline' está permitido; esto evita hashes que cambian. */
  .hero__inner > :nth-child(2) { --i: 1; }
  .hero__inner > :nth-child(3) { --i: 2; }
  .hero__inner > :nth-child(4) { --i: 3; }
  .hero__inner > :nth-child(5) { --i: 4; }
  .hero__inner > :nth-child(6) { --i: 5; }

  @keyframes aurora {
    0%, 100% { transform: translateX(-50%) translateY(0) scale(1); opacity: 1; }
    50% { transform: translateX(-46%) translateY(16px) scale(1.05); opacity: 0.85; }
  }

  .hero__avatar { margin-bottom: 28px; }

  .hero__name {
    font-weight: 700;
    font-size: clamp(48px, 9vw, 84px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text);
    text-shadow: 0 4px 60px rgba(0, 0, 0, 0.5);
  }
  .hero__tagline {
    margin-top: 18px;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--muted);
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero__identity {
    margin-top: 14px;
    font-size: 16px;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 42ch;
    text-wrap: balance;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.35em;
  }

  .hero__actions {
    margin-top: 36px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__foot {
    width: 100%;
    max-width: 560px;
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .hero__stats {
    width: 100%;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }

  /* ------------------------------ grillas ------------------------------ */

  .grid { display: grid; gap: 18px; }
  .grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .meetups__lead {
    max-width: 52ch;
    margin-bottom: clamp(28px, 4vw, 40px);
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* sobre mí */
  .sobre {
    display: grid;
    justify-items: center;
    gap: clamp(36px, 5vw, 56px);
  }
  .sobre__intro {
    display: grid;
    justify-items: center;
    max-width: 46ch;
  }
  .sobre__lead {
    text-align: center;
    font-size: clamp(18px, 2.2vw, 21px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--muted);
  }
  .facetas {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px);
  }
  .faceta {
    border-top: 1px solid var(--hairline);
    padding-top: 26px;
  }
  .faceta__marca {
    display: flex;
    align-items: center;
    height: 48px;
    margin-bottom: 14px;
  }
  .faceta__mark {
    width: auto;
    max-height: 100%;
    max-width: 140px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .faceta h3 {
    margin-bottom: 10px;
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }
  .faceta p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* manifiesto */
  .manifiesto__texto {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
    font-weight: 600;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-white);
    text-wrap: balance;
  }
  .manifiesto__texto .word {
    display: inline-block;
    margin-right: 0.28em;
    will-change: opacity, color;
  }
  .principios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px);
    margin-top: clamp(56px, 8vw, 88px);
  }
  .principio {
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .principio h3 {
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 8px;
  }
  .principio p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* novedades: feed, no dos columnas que se pisan */
  .novedades {
    display: grid;
    max-width: 52ch;
  }
  .entrada {
    display: grid;
    justify-items: start;
    text-align: left;
    gap: 14px;
    padding-block: 32px;
    border-top: 1px solid var(--hairline);
  }
  .entrada:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .entrada__kicker {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .entrada__title {
    font-weight: 700;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .entrada__text {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--text);
    max-width: 42ch;
  }

  /* SyS: mención compacta, no protagonista */
  .sys {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
  }
  .sys__logo img { width: min(180px, 100%); height: auto; opacity: 0.85; }
  .sys__body { display: grid; gap: 12px; justify-items: start; }
  .sys__kicker {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .sys__copy {
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
    max-width: 52ch;
  }
  .sys__addr {
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* contacto */
  .contacto {
    max-width: 640px;
    margin-inline: auto;
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
  }
  .contacto__ctas { width: 100%; }
  .contacto__sub {
    font-size: clamp(18px, 2.2vw, 21px);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--muted);
  }
  .contacto__recruiter {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }
  .contacto__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 48px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
    width: 100%;
    margin: 0;
    padding-left: 0;
    list-style: none;
  }
  .contacto__links li { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .contacto__label { font-size: 14px; color: var(--muted); }
  .contacto__links a {
    font-weight: 500;
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
    padding: 8px 0;
    transition: color var(--fast) var(--ease);
  }
  .contacto__links a:hover { color: var(--color-electric); }
  .contacto__copy {
    border: 0;
    background: transparent;
    color: var(--color-electric);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 0;
    position: relative;
  }

  /* ------------------------------ responsive ------------------------------ */

  @media (max-width: 900px) {
    .facetas, .principios { grid-template-columns: 1fr; gap: 28px; }
    .sys { grid-template-columns: 1fr; gap: 28px; }
    .sys__logo img { width: min(220px, 65%); }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 72px; padding-bottom: 64px; }
    .grid--2 { grid-template-columns: 1fr; }
    .hero__actions { flex-direction: column; width: min(100%, 360px); }
    .hero__actions :global(.cta) { width: 100%; }
    .manifiesto__texto br { display: none; }
  }
</style>
