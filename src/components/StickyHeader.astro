---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/profile';

interface Props {
  homeHref?: string;
  pinned?: boolean;
}
const { homeHref = '#inicio', pinned = false } = Astro.props;

const sections = [
  { href: '/#que-hago', label: 'Qué hago' },
  { href: '/#meetups', label: 'Meetups' },
  { href: '/#ahora', label: 'Ahora' },
  { href: '/#contacto', label: 'Contacto' },
];
---

<header class:list={['sh', pinned && 'is-visible']} id="sticky-header" aria-label="Navegación" data-pinned={pinned ? 'true' : undefined}>
  <div class="container sh__inner">
    <a class="sh__brand" href={homeHref}>{profile.name}</a>
    <nav class="sh__nav" aria-label="Secciones">
      {sections.map((s) => (
        <a href={s.href} data-umami-event={`click-nav-${s.label.toLowerCase().replace(/\s+/g, '-')}`}>
          {s.label}
        </a>
      ))}
    </nav>
    <a
      class="sh__cta"
      href={profile.calendly.url}
      target="_blank"
      rel="noopener"
      data-umami-event="click-calendly-header"
      aria-label={`${profile.calendly.label} (se abre en otra pestaña)`}
    >
      <Icon name="lucide:calendar" size={18} aria-hidden="true" />
      <span class="sh__cta-label">{profile.calendly.label}</span>
      <span class="sr-only">(se abre en otra pestaña)</span>
    </a>
  </div>
</header>

<style>
  .sh {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--header-h);
    background: rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--hairline);
    transform: translateY(-100%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform var(--base) var(--ease),
      opacity var(--base) var(--ease),
      visibility 0s linear var(--base);
  }
  .sh.is-visible {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition:
      transform var(--base) var(--ease),
      opacity var(--base) var(--ease),
      visibility 0s;
  }

  .sh__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .sh__brand {
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }
  .sh__nav {
    display: flex;
    gap: 4px 18px;
    font-size: 14px;
    font-weight: 500;
  }
  .sh__nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 8px 0;
    transition: color var(--fast) var(--ease);
  }
  .sh__nav a:hover { color: var(--text); }
  .sh__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 980px;
    background: var(--color-electric-deep);
    color: var(--color-white);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .sh__nav { display: none; }
  }
</style>
