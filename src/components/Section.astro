---
interface Props {
  id: string;
  /** Texto chico gris arriba del título (estilo "subhead" de Apple). */
  kicker?: string;
  title?: string;
  tone?: 'white' | 'gray' | 'think';
  center?: boolean;
  compact?: boolean;
  class?: string;
}
const { id, kicker, title, tone = 'white', center = false, compact = false, class: cls } = Astro.props;
const headingId = `${id}-titulo`;
---

<section
  class:list={['section', `section--${tone}`, compact && 'section--compact', cls]}
  id={id}
  aria-labelledby={kicker || title ? headingId : undefined}
>
  <div class="container">
    {
      (kicker || title) && (
        <header class:list={['section__head', { 'section__head--center': center }]}>
          {kicker && !title && (
            <h2 class="section__kicker" id={headingId} data-reveal>{kicker}</h2>
          )}
          {kicker && title && <p class="section__kicker" data-reveal>{kicker}</p>}
          {title && <h2 class="section__title" id={headingId} data-reveal>{title}</h2>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: clamp(72px, 10vw, 128px);
    scroll-margin-top: var(--header-h);
  }
  .section--compact { padding-block: clamp(40px, 6vw, 64px); }
  .section--white { background: var(--color-black); }
  .section--gray { background: var(--surface-band); }
  .section--think {
    position: relative;
    background: var(--color-elev-1);
    overflow: hidden;
  }
  .section--think::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 55% 60% at 50% 20%, rgba(33, 150, 243, 0.1) 0%, transparent 65%);
    pointer-events: none;
  }

  .section__head {
    display: grid;
    gap: 10px;
    margin-bottom: clamp(36px, 5vw, 56px);
    max-width: 720px;
  }
  .section__head--center {
    text-align: center;
    justify-items: center;
    margin-inline: auto;
  }
  .section__kicker {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-electric);
    margin: 0;
  }
  .section__title {
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }
</style>
