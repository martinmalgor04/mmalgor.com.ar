---
interface Props {
  items: readonly { value: string; label: string }[];
}
const { items } = Astro.props;
---

<ul class="stats" role="list">
  {
    items.map((s) => (
      <li class="stat">
        <span class="stat__value" data-count={s.value}>{s.value}</span>
        <span class="stat__label">{s.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 8px;
    text-align: center;
  }
  .stat + .stat { border-left: 1px solid var(--hairline); }
  .stat__value {
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    text-shadow: 0 0 26px rgba(33, 150, 243, 0.35);
    font-variant-numeric: tabular-nums;
    min-width: 5.5ch;
  }
  .stat__label {
    font-size: 13px;
    line-height: 1.3;
    color: var(--muted);
  }
</style>
