---
import { formatStat } from '../data/profile';

interface Props {
  items: readonly { value: number; prefix: string; label: string }[];
  kicker?: string;
}
const { items, kicker } = Astro.props;
---

<div class="stats-wrap">
  {kicker && <p class="stats__kicker">{kicker}</p>}
  <ul class="stats" role="list">
    {
      items.map((s) => {
        const shown = formatStat(s.prefix, s.value);
        return (
          <li class="stat">
            <span class="sr-only">{shown} {s.label}</span>
            <span
              class="stat__value"
              data-count={s.value}
              data-prefix={s.prefix}
              aria-hidden="true"
            >{shown}</span>
            <span class="stat__label" aria-hidden="true">{s.label}</span>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .stats-wrap {
    display: grid;
    gap: 14px;
    justify-items: center;
    width: 100%;
  }
  .stats__kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stats {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .stat {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 4px 8px;
    text-align: center;
  }
  .stat + .stat { border-left: 1px solid var(--hairline); }
  .stat__value {
    font-weight: 700;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    text-shadow: 0 0 26px rgba(33, 150, 243, 0.35);
    font-variant-numeric: tabular-nums;
    min-width: 5.5ch;
  }
  .stat__label {
    font-size: 14px;
    line-height: 1.3;
    color: var(--muted);
    text-wrap: balance;
  }
</style>
