---
import type { MeetupPhoto } from '../data/meetups';

interface Props {
  photos: MeetupPhoto[];
}
const { photos } = Astro.props;
const even = photos.length === 4;
---

{
  photos.length > 0 && (
    <div class:list={['gal', even && 'gal--even']}>
      {
        photos.map((photo) => (
          <button class="shot" type="button" data-lightbox={photo.src} data-alt={photo.alt} aria-label={`Ampliar foto: ${photo.alt}`}>
            <img src={photo.src} alt="" width="1200" height="900" loading="lazy" />
          </button>
        ))
      }
    </div>
  )
}

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .shot {
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
    display: block;
    width: 100%;
  }
  .gal:not(.gal--even) .shot:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
</style>
