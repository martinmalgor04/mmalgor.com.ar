---
import { Icon } from 'astro-icon/components';

/** Card gris elevada sobre negro. Si hay href, es un link a WhatsApp por tema. */
interface Props {
  title: string;
  icon?: string;
  href?: string;
  event?: string;
}
const { title, icon, href, event } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag
  class="card"
  data-reveal
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener' : undefined}
  data-umami-event={event}
>
  {icon && <span class="card__icon" aria-hidden="true"><Icon name={icon} size={22} /></span>}
  <span class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__text"><slot /></p>
  </span>
  {href && (
    <span class="card__go" aria-hidden="true">
      <Icon name="lucide:arrow-up-right" size={16} />
    </span>
  )}
  {href && <span class="sr-only">(se abre en otra pestaña)</span>}
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    padding: 30px 28px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform var(--base) var(--ease), box-shadow var(--base) var(--ease), border-color var(--base) var(--ease);
  }
  a.card:hover {
    transform: translateY(-2px);
    border-color: rgba(162, 198, 212, 0.28);
    box-shadow: var(--shadow-md), 0 0 46px rgba(33, 150, 243, 0.1);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--color-electric);
    background: rgba(33, 150, 243, 0.14);
    box-shadow: 0 0 22px rgba(33, 150, 243, 0.18);
    margin-bottom: 22px;
  }
  .card__title {
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 8px;
  }
  .card__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }
  .card__go {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--faint);
  }
  a.card:hover .card__go { color: var(--color-electric); }

  @media (max-width: 640px) {
    .card {
      display: grid;
      grid-template-columns: 40px 1fr auto;
      align-items: start;
      column-gap: 14px;
      padding: 22px 20px;
    }
    .card__icon {
      width: 40px;
      height: 40px;
      margin-bottom: 0;
      grid-row: 1 / 3;
    }
    .card__body { grid-column: 2; }
    .card__go { position: static; }
  }
</style>
