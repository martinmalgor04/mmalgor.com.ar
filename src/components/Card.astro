---
import { Icon } from 'astro-icon/components';

/** Card gris elevada sobre negro, radio grande, ícono en tile con acento eléctrico. */
interface Props {
  title: string;
  icon?: string;
  num?: string;
}
const { title, icon, num } = Astro.props;
---

<article class="card" data-reveal>
  {icon && <span class="card__icon" aria-hidden="true"><Icon name={icon} size={22} /></span>}
  {num && <span class="card__num" aria-hidden="true">{num}</span>}
  <h3 class="card__title">{title}</h3>
  <p class="card__text"><slot /></p>
</article>

<style>
  .card {
    padding: 30px 28px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-sm);
    transition: transform var(--base) var(--ease), box-shadow var(--base) var(--ease), border-color var(--base) var(--ease);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: rgba(162, 198, 212, 0.28);
    box-shadow: var(--shadow-md), 0 0 46px rgba(33, 150, 243, 0.1);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    color: var(--color-electric);
    background: rgba(33, 150, 243, 0.14);
    box-shadow: 0 0 22px rgba(33, 150, 243, 0.18);
    margin-bottom: 22px;
  }
  .card__num {
    display: block;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--color-electric);
    text-shadow: 0 0 20px rgba(33, 150, 243, 0.4);
    font-variant-numeric: tabular-nums;
    margin-bottom: 18px;
  }
  .card__title {
    font-weight: 600;
    font-size: 21px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 8px;
  }
  .card__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
