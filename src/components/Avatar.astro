---
interface Props {
  initials: string;
  alt: string;
  src?: string;
}
const { initials, alt, src } = Astro.props;
---

<div class="avatar-wrap">
<div class="avatar" role={src ? undefined : 'img'} aria-label={src ? undefined : alt}>
    {
      src ? (
        <img src={src} width="224" height="224" alt={alt} loading="eager" fetchpriority="high" />
      ) : (
        <span class="avatar__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>
</div>

<style>
  .avatar-wrap {
    width: 96px;
    height: 96px;
  }
  .avatar {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-navy-mid), var(--color-navy));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 18px 44px rgba(0, 0, 0, 0.6),
      0 0 40px 4px rgba(33, 150, 243, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .avatar__initials {
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -0.03em;
    color: var(--color-white);
    line-height: 1;
    padding-top: 2px;
    text-shadow: 0 0 20px rgba(162, 198, 212, 0.4);
  }
  @media (min-width: 768px) {
    .avatar-wrap { width: 112px; height: 112px; }
    .avatar__initials { font-size: 40px; }
  }
</style>
