---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Avatar circular con un anillo de luz propio (el "destello" de marca,
 * resuelto en el box-shadow, sin capas de blur extra detrás para no
 * ensuciar el fondo). Sin foto: monograma blanco sobre navy. Con foto:
 * <Image> con width/height fijos, el layout no se mueve.
 */
interface Props {
  initials: string;
  alt: string;
  src?: ImageMetadata;
}
const { initials, alt, src } = Astro.props;
---

<div class="avatar-wrap">
  <div class="avatar" role="img" aria-label={alt}>
    {
      src ? (
        <Image src={src} width={224} height={224} alt="" loading="eager" fetchpriority="high" />
      ) : (
        <span class="avatar__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>
</div>

<style>
  .avatar-wrap {
    width: 96px;
    height: 96px;
  }
  .avatar {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-navy-mid), var(--color-navy));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 18px 44px rgba(0, 0, 0, 0.6),
      0 0 40px 4px rgba(33, 150, 243, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar__initials {
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -0.03em;
    color: var(--color-white);
    line-height: 1;
    padding-top: 2px;
    text-shadow: 0 0 20px rgba(162, 198, 212, 0.4);
  }
  @media (min-width: 768px) {
    .avatar-wrap { width: 112px; height: 112px; }
    .avatar__initials { font-size: 40px; }
  }
</style>
