---
import MeetupGallery from './MeetupGallery.astro';
import { meetups } from '../data/meetups';
---

<div class="meets">
  {
    meetups.map((m) => (
      <article class="meet">
        <header class="meet__head">
          <p class="meet__meta">
            {m.logo && (
              <img class="meet__logo" src={m.logo.src} alt={m.logo.alt} width="1024" height="125" />
            )}
            <time datetime={m.date}>{m.dateLabel}</time>
            <span aria-hidden="true"> · </span>
            {m.place}
          </p>
          <h3 class="meet__title">{m.title}</h3>
          <p class="meet__text">{m.text}</p>
          {m.credit && <p class="meet__credit">{m.credit}</p>}
        </header>
        {m.photos.length > 0 && <MeetupGallery photos={m.photos} />}
        {
          m.video && (
            <figure class="meet__video">
              <video
                src={m.video.src}
                poster={m.video.poster}
                controls
                playsinline
                preload="none"
                aria-label={m.video.label}
              />
              <figcaption>{m.video.label}</figcaption>
            </figure>
          )
        }
      </article>
    ))
  }
</div>

<dialog class="lb" aria-label="Foto">
  <img alt="" />
  <form method="dialog">
    <button type="submit" aria-label="Cerrar">Cerrar</button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lb');
  const img = dialog?.querySelector('img');
  if (dialog && img) {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.dataset.lightbox;
        if (!src) return;
        const alt = btn.dataset.alt ?? '';
        img.src = src;
        img.alt = alt;
        dialog.setAttribute('aria-label', alt || 'Foto');
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .meets {
    display: grid;
    gap: clamp(56px, 8vw, 88px);
  }
  .meet {
    display: grid;
    gap: 22px;
  }
  .meet__head {
    display: grid;
    gap: 10px;
    max-width: 62ch;
  }
  .meet__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .meet__logo {
    width: auto;
    height: 28px;
    margin: 0;
  }
  .meet__title {
    font-weight: 700;
    font-size: clamp(26px, 3.6vw, 34px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .meet__text {
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }
  .meet__credit {
    font-size: 15px;
    line-height: 1.45;
    color: var(--faint);
  }

  .meet__video {
    margin: 0;
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .meet__video video {
    width: min(300px, 100%);
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    background: var(--color-black);
    display: block;
  }
  .meet__video figcaption {
    font-size: 14px;
    line-height: 1.45;
    color: var(--faint);
    max-width: 44ch;
  }

  .lb {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: min(920px, 94vw);
  }
  .lb::backdrop { background: rgba(0, 0, 0, 0.82); }
  .lb img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .lb form { display: flex; justify-content: center; margin-top: 12px; }
  .lb button {
    border: 0;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 15px;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .meet__video video { width: min(200px, 100%); }
  }
</style>
