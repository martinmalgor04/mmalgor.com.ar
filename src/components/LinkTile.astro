---
import { Icon } from 'astro-icon/components';
import type { LinkItem } from '../data/links';

/**
 * Fila compacta: ícono + título/sub + flecha.
 * kind=primary: azul eléctrico sólido con resplandor propio (el CTA principal).
 * Si `copy` está, aparece un botón que copia el valor al portapapeles.
 */
type Props = LinkItem;
const { label, sub, href, icon, kind, event, external, copy } = Astro.props;
---

<div class:list={['tile-wrap', `tile-wrap--${kind}`]} data-tile>
  <a
    class:list={['tile', `tile--${kind}`]}
    href={href}
    rel={external ? 'me noopener' : undefined}
    target={external ? '_blank' : undefined}
    data-umami-event={event}
  >
    <span class="tile__icon" aria-hidden="true"><Icon name={icon} size={20} /></span>
    <span class="tile__text">
      <span class="tile__label">{label}</span>
      {sub && <span class="tile__sub">{sub}</span>}
    </span>
    {
      !copy && (
        <span class="tile__arrow" aria-hidden="true">
          <Icon name="lucide:arrow-up-right" size={16} />
        </span>
      )
    }
  </a>

  {
    copy && (
      <button class="tile__copy" type="button" data-copy={copy} aria-label={`Copiar ${copy}`}>
        <span class="tile__copy-icon" aria-hidden="true"><Icon name="lucide:copy" size={16} /></span>
        <span class="tile__copied" aria-live="polite">Copiado</span>
      </button>
    )
  }
</div>

<style>
  .tile-wrap {
    position: relative;
    perspective: 900px;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 12px 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    isolation: isolate;
    transform-style: preserve-3d;
    transition:
      box-shadow var(--base) var(--ease),
      border-color var(--base) var(--ease),
      background var(--base) var(--ease);
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--spot-x, 50%) var(--spot-y, 0%),
      rgba(255, 255, 255, 0.1),
      transparent 42%
    );
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--base) var(--ease);
  }
  .tile > :not(.tile__text) { position: relative; z-index: 1; }
  .tile__arrow { z-index: 1; }
  .tile:hover {
    border-color: rgba(162, 198, 212, 0.3);
    box-shadow: var(--shadow-md);
  }
  .tile:hover::before { opacity: 1; }

  .tile__icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--surface-alt);
    color: var(--color-electric);
  }

  .tile__text {
    position: absolute;
    left: 52px;
    right: 52px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: center;
    z-index: 1;
    pointer-events: none;
  }
  .tile__label {
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .tile__sub {
    font-size: 13px;
    line-height: 1.3;
    color: var(--muted);
    letter-spacing: -0.005em;
  }

  .tile__arrow {
    position: static;
    flex-shrink: 0;
    margin-left: auto;
    color: var(--faint);
    transition: color var(--fast) var(--ease), transform var(--base) var(--ease);
  }
  .tile:hover .tile__arrow {
    color: var(--color-electric);
    transform: translate(2px, -2px);
  }

  /* --- primary: resplandor propio, el "destello" de la marca --- */
  .tile--primary {
    background: linear-gradient(160deg, var(--color-electric-hover), var(--color-electric) 60%, var(--color-electric-active));
    border-color: rgba(255, 255, 255, 0.18);
    color: var(--color-white);
    box-shadow: var(--shadow-md), var(--glow-electric);
  }
  .tile--primary::before {
    background: radial-gradient(
      460px circle at var(--spot-x, 50%) var(--spot-y, 0%),
      rgba(255, 255, 255, 0.22),
      transparent 44%
    );
  }
  .tile--primary:hover { box-shadow: var(--shadow-lg), 0 0 90px rgba(33, 150, 243, 0.5); }
  .tile--primary .tile__icon { background: rgba(255, 255, 255, 0.18); color: var(--color-white); }
  .tile--primary .tile__sub { color: rgba(255, 255, 255, 0.7); }
  .tile--primary .tile__arrow { color: rgba(255, 255, 255, 0.6); }
  .tile--primary:hover .tile__arrow { color: var(--color-white); }

  /* --- copiar --- */
  .tile-wrap:has(.tile__copy) .tile { padding-right: 48px; }
  .tile__copy {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition: background var(--fast) var(--ease), color var(--fast) var(--ease);
  }
  .tile__copy:hover { background: var(--surface-alt); color: var(--text); }
  .tile__copied {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(0, -50%) translateY(4px);
    padding: 6px 10px;
    border-radius: 8px;
    background: var(--color-white);
    color: var(--color-black);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--fast) var(--ease), transform var(--fast) var(--ease);
  }
  .tile__copy.is-copied .tile__copied { opacity: 1; transform: translate(0, -50%); }
  .tile__copy.is-copied .tile__copy-icon { opacity: 0; }
</style>
